# Normalize line endings for text; let Git treat common binaries as binary.
* text=auto eol=lf

*.swift text eol=lf diff=swift
*.md text eol=lf
*.sh text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.plist text eol=lf
*.xcconfig text eol=lf
*.pbxproj text eol=lf
*.xcscheme text eol=lf
*.entitlements text eol=lf
*.storyboard text eol=lf
*.strings text eol=lf

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
